generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  passwordHash String
  role         Role       @default(STAFF)
  isActive     Boolean    @default(true)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

model MilitiaRecord {
  id               Int               @id @default(autoincrement())
  fullName         String
  gender           String            @default("Nam")
  militiaType      String?
  militiaUnit      String?
  nationalId       String            @unique
  dateOfBirth      DateTime
  address          String
  classification   Classification    @default(NONG_COT)
  joinedDate       DateTime
  status           MilitiaStatus     @default(ACTIVE)
  attachments      Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trainingHistories TrainingHistory[]
  equipments       Equipment[]
}

enum Classification {
  NONG_COT
  CO_DONG
  TAI_CHO
}

enum MilitiaStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
}

model TrainingHistory {
  id              Int           @id @default(autoincrement())
  recordId        Int
  militiaRecord   MilitiaRecord @relation(fields: [recordId], references: [id])
  courseName      String
  startDate       DateTime
  endDate         DateTime
  result          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Equipment {
  id              Int           @id @default(autoincrement())
  recordId        Int
  militiaRecord   MilitiaRecord @relation(fields: [recordId], references: [id])
  equipmentName   String
  quantity        Int           @default(1)
  issueDate       DateTime
  status          EquipmentStatus @default(ISSUED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum EquipmentStatus {
  ISSUED
  RETURNED
  LOST
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model UserRoleConfig {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  fullName  String?
  role      String   @default("DAN_QUAN") // SUPER_ADMIN | DAN_QUAN | HAU_CAN
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogisticsInventory {
  id        Int      @id @default(autoincrement())
  itemName  String
  category  String   @default("Quân trang")
  quantity  Int      @default(0)
  unit      String   @default("Cái")
  condition String   @default("Tốt")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogisticsDistribution {
  id            Int       @id @default(autoincrement())
  itemName      String
  recipientName String
  recipientUnit String?
  quantity      Int       @default(1)
  issueDate     DateTime  @default(now())
  returnDate    DateTime?
  status        String    @default("ISSUED") // ISSUED | RETURNED
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LogisticsFinance {
  id             Int      @id @default(autoincrement())
  title          String
  type           String   @default("CHI_AN") // THU | CHI_AN | PHU_CAP | KHAC
  amount         Float    @default(0)
  recordDate     DateTime @default(now())
  personInCharge String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LogisticsDocument {
  id          Int      @id @default(autoincrement())
  title       String
  period      String?
  note        String?
  attachments Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkTask {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  department   String    @default("DAN_QUAN") // DAN_QUAN | HAU_CAN
  assigneeName String
  assignedBy   String?
  priority     String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  dueDate      DateTime?
  progress     Int       @default(0) // 0 - 100
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


